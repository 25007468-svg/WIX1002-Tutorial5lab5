import java.util.Random;
import java.util.Scanner;

public class Question5 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        int[] numbers = new int[20];
        System.out.println("A list of 20 random integer within 0 to 100");
        for (int i = 0; i < 20; i++) {
            numbers[i] = random.nextInt(101);
            System.out.print(numbers[i] + (i == 19 ? "" : ", "));
        }
        System.out.println();

        // Sort array in descending order
        for (int i = 0; i < numbers.length - 1; i++) {
            for (int j = 0; j < numbers.length - 1 - i; j++) {
                if (numbers[j] < numbers[j + 1]) {
                    int temp = numbers[j];
                    numbers[j] = numbers[j + 1];
                    numbers[j + 1] = temp;
                }
            }
        }

        System.out.println("Array in descending order");
        for (int i = 0; i < numbers.length; i++) {
            System.out.print(numbers[i] + (i == numbers.length - 1 ? "" : ", "));
        }
        System.out.println();

        System.out.print("Enter a number to search: ");
        int target = scanner.nextInt();

        // Linear Search
        int linearLoops = 0;
        boolean linearFound = false;
        for (int i = 0; i < numbers.length; i++) {
            linearLoops++;
            if (numbers[i] == target) {
                linearFound = true;
                break;
            }
        }

        if (linearFound) {
            System.out.println(target + " found");
        } else {
            System.out.println(target + " not found");
        }
        System.out.println("Linear Search - " + linearLoops + " loop(s)");

        // Binary Search (for descending ordered array)
        int binaryLoops = 0;
        boolean binaryFound = false;
        int low = 0;
        int high = numbers.length - 1;

        while (low <= high) {
            binaryLoops++;
            int mid = low + (high - low) / 2;

            if (numbers[mid] == target) {
                binaryFound = true;
                break;
            } else if (numbers[mid] < target) {
                high = mid - 1; // Search in left half because it's descending
            } else {
                low = mid + 1;  // Search in right half
            }
        }

        if (binaryFound) {
            System.out.println(target + " found");
        } else {
            System.out.println(target + " not found");
        }
        System.out.println("Binary Search - " + binaryLoops + " loop(s)");

        scanner.close();
    }
}
